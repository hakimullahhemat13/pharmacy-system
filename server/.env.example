# Copy this file to ".env" and fill in YOUR values there.
# .env itself must NEVER go to GitHub (it is in .gitignore).

PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=pharmacy_app
DB_PASSWORD=put-the-pharmacy_app-password-here
DB_NAME=pharmacy_db

JWT_SECRET=put-a-long-random-text-here-at-least-32-characters
